<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DWG-Revit-Optimizer-AutoCAD2021-Installer</AssemblyName>
    <RootNamespace>DWGOptimizer.AutoCAD2021.Installer</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DWGOptimizer.AutoCAD2021\DWGOptimizer.AutoCAD2021.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DWGOptimizer.Engine.AutoCAD2021\DWGOptimizer.Engine.AutoCAD2021.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DWGOptimizer.CoreConsole2021\DWGOptimizer.CoreConsole2021.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DWGOptimizer.BatchRunner\DWGOptimizer.BatchRunner.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="..\DWGOptimizer.AutoCAD2021\bin\$(Configuration)\net48\DWGOptimizer.AutoCAD2021.dll" LogicalName="Payload.DWGOptimizer.AutoCAD2021.dll" />
    <EmbeddedResource Include="..\DWGOptimizer.Contracts\bin\$(Configuration)\net48\DWGOptimizer.Contracts.dll" LogicalName="Payload.DWGOptimizer.Contracts.dll" />
    <EmbeddedResource Include="..\DWGOptimizer.Engine.AutoCAD2021\bin\$(Configuration)\net48\DWGOptimizer.Engine.AutoCAD2021.dll" LogicalName="Payload.DWGOptimizer.Engine.AutoCAD2021.dll" />
    <EmbeddedResource Include="..\DWGOptimizer.CoreConsole2021\bin\$(Configuration)\net48\DWGOptimizer.CoreConsole2021.dll" LogicalName="Payload.DWGOptimizer.CoreConsole2021.dll" />
    <EmbeddedResource Include="..\DWGOptimizer.BatchRunner\bin\$(Configuration)\net48\DWGOptimizer.BatchRunner.exe" LogicalName="Payload.DWGOptimizer.BatchRunner.exe" />
  </ItemGroup>
  <Target Name="CopyInstaller" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\dist" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MSBuildProjectDirectory)\..\dist\DWG-Revit-Optimizer-AutoCAD2021-Installer.exe" />
  </Target>
</Project>
