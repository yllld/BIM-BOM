<Window x:Class="FamilyConverter.Revit2021.UI.ConversionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG Converter - настройки"
        Width="660"
        Height="730"
        MinWidth="600"
        MinHeight="620"
        Background="#F7F6FA"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DwgConverterTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Style="{StaticResource DwgRootDockStyle}">
        <Border DockPanel.Dock="Top" Style="{StaticResource DwgTopBarStyle}">
            <StackPanel>
                <TextBlock Text="Настройки конвертации" Style="{StaticResource DwgHeaderTitleTextStyle}" />
                <TextBlock Text="Профиль Simple Convert для текущего DWG" Style="{StaticResource DwgHeaderSubtitleTextStyle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource DwgFooterBarStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить"
                        Width="126"
                        Style="{StaticResource DwgPrimaryButtonStyle}"
                        IsDefault="True"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click" />
                <Button Content="Отмена"
                        Width="112"
                        IsCancel="True" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <Border Style="{StaticResource DwgSectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Режим преобразования" Style="{StaticResource DwgSectionTitleTextStyle}" />
                        <CheckBox x:Name="CreateExtrusionsCheckBox" Content="Создавать нативные Extrusion для распознанных тел" />
                        <CheckBox x:Name="TryExtrusionBeforeFreeFormCheckBox">
                            <TextBlock Text="Пробовать Extrusion для сомнительных профилей с откатом в FreeFormElement"
                                       TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="UseFreeFormCheckBox" Content="Для сложных Solid использовать FreeFormElement" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DwgSectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Слои, исходник и отчеты" Style="{StaticResource DwgSectionTitleTextStyle}" />
                        <CheckBox x:Name="CreateSubcategoriesCheckBox">
                            <TextBlock Text="Создавать подкатегории по слоям DWG, если слой определен"
                                       TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="DeleteSourceCheckBox">
                            <TextBlock Text="Удалить исходный DWG после успешного преобразования"
                                       TextWrapping="Wrap" />
                        </CheckBox>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="JsonReportCheckBox" Content="Создать отчет JSON" Margin="0,0,24,0" />
                            <CheckBox Grid.Column="1" x:Name="CsvReportCheckBox" Content="Создать отчет CSV" Margin="0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DwgSectionCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Допуски" Style="{StaticResource DwgSectionTitleTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Минимальный объем Solid, мм³" Style="{StaticResource DwgLabelTextStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="MinVolumeTextBox" Style="{StaticResource DwgCompactTextBoxStyle}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Допуск совпадения габаритов, мм" Style="{StaticResource DwgLabelTextStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="BBoxToleranceTextBox" Style="{StaticResource DwgCompactTextBoxStyle}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Допуск сравнения объема, %" Style="{StaticResource DwgLabelTextStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="VolumeToleranceTextBox" Style="{StaticResource DwgCompactTextBoxStyle}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Допуск замыкания контура, мм" Style="{StaticResource DwgLabelTextStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="LoopToleranceTextBox" Style="{StaticResource DwgCompactTextBoxStyle}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Минимальная уверенность для Extrusion" Style="{StaticResource DwgLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="ConfidenceTextBox" Style="{StaticResource DwgCompactTextBoxStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
