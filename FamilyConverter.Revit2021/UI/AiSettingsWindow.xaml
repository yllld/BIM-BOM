<Window x:Class="FamilyConverter.Revit2021.UI.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG Converter - AI"
        Width="660"
        Height="430"
        MinWidth="600"
        MinHeight="390"
        Background="#F7F6FA"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DwgConverterTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Style="{StaticResource DwgRootDockStyle}">
        <Border DockPanel.Dock="Top" Style="{StaticResource DwgTopBarStyle}">
            <StackPanel>
                <TextBlock Text="DWG Converter - AI" Style="{StaticResource DwgHeaderTitleTextStyle}" />
                <TextBlock Text="Опциональный советник для сомнительных случаев" Style="{StaticResource DwgHeaderSubtitleTextStyle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource DwgFooterBarStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить"
                        Width="126"
                        Style="{StaticResource DwgPrimaryButtonStyle}"
                        IsDefault="True"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click" />
                <Button Content="Отмена"
                        Width="112"
                        IsCancel="True" />
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Border Style="{StaticResource DwgCardStyle}">
                <StackPanel>
                    <TextBlock Text="Настройки AI-помощника" Style="{StaticResource DwgSectionTitleTextStyle}" />
                    <CheckBox x:Name="UseAiCheckBox">
                        <TextBlock Text="Использовать AI-советник для сомнительных случаев"
                                   TextWrapping="Wrap" />
                    </CheckBox>

                    <TextBlock Text="Локальный JSON-конфиг" Style="{StaticResource DwgLabelTextStyle}" Margin="0,4,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="126" />
                            <ColumnDefinition Width="108" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="AiConfigPathTextBox"
                                 HorizontalScrollBarVisibility="Auto"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="1"
                                Content="Выбрать JSON"
                                Margin="0,0,8,0"
                                Click="BrowseAiConfigButton_Click" />
                        <Button Grid.Column="2"
                                Content="Проверить"
                                Click="ValidateAiConfigButton_Click" />
                    </Grid>

                    <Border Style="{StaticResource DwgNoticeStyle}" Margin="0,14,0,0">
                        <TextBlock x:Name="AiConfigStatusText"
                                   Style="{StaticResource DwgSmallMutedTextStyle}"
                                   Text="API-ключи не хранятся в плагине. Используется только локальный JSON-файл пользователя." />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
