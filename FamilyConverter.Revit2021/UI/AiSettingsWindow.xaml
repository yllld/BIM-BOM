<Window x:Class="FamilyConverter.Revit2021.UI.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG Converter - AI"
        Width="620"
        Height="330"
        MinWidth="560"
        MinHeight="300"
        Background="#F7F4FF"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#8C30FF" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#5D16B7" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#DED0F8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#665E73" />

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#CDB4F6" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2,0,10" />
            <Setter Property="Foreground" Value="#25153D" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="18,14">
            <TextBlock Text="AI-настройки" Foreground="#FFFFFF" FontSize="21" FontWeight="SemiBold" />
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14">
            <Button Content="Сохранить" Width="120" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="SaveButton_Click" />
            <Button Content="Отмена" Width="100" IsCancel="True" />
        </StackPanel>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="126" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                          x:Name="UseAiCheckBox"
                          Content="Использовать AI-советник для сомнительных случаев" />
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="AiConfigPathTextBox" Margin="0,0,8,0" />
                <Button Grid.Row="1" Grid.Column="1" Content="Выбрать JSON" Margin="0,0,8,0" Click="BrowseAiConfigButton_Click" />
                <Button Grid.Row="1" Grid.Column="2" Content="Проверить" Click="ValidateAiConfigButton_Click" />
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                           x:Name="AiConfigStatusText"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Text="API-ключи не хранятся в плагине. Используется только локальный JSON пользователя." />
            </Grid>
        </Border>
    </DockPanel>
</Window>
