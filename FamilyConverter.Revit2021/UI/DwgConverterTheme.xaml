<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="DwgAccentColor">#8A2BFF</Color>
    <Color x:Key="DwgAccentHoverColor">#7420E6</Color>
    <Color x:Key="DwgAccentPressedColor">#5D16B7</Color>
    <Color x:Key="DwgWindowBackgroundColor">#F7F6FA</Color>
    <Color x:Key="DwgCardColor">#FFFFFF</Color>
    <Color x:Key="DwgBorderColor">#DDD7E8</Color>
    <Color x:Key="DwgSoftBorderColor">#ECE6F5</Color>
    <Color x:Key="DwgTextColor">#181426</Color>
    <Color x:Key="DwgMutedTextColor">#625A70</Color>
    <Color x:Key="DwgSubtleTextColor">#8E879A</Color>
    <Color x:Key="DwgAccentSoftColor">#F0E6FF</Color>
    <Color x:Key="DwgButtonHoverColor">#FAF7FF</Color>
    <Color x:Key="DwgDisabledColor">#C9C3D5</Color>

    <SolidColorBrush x:Key="DwgAccentBrush" Color="{StaticResource DwgAccentColor}" />
    <SolidColorBrush x:Key="DwgAccentHoverBrush" Color="{StaticResource DwgAccentHoverColor}" />
    <SolidColorBrush x:Key="DwgAccentPressedBrush" Color="{StaticResource DwgAccentPressedColor}" />
    <SolidColorBrush x:Key="DwgWindowBackgroundBrush" Color="{StaticResource DwgWindowBackgroundColor}" />
    <SolidColorBrush x:Key="DwgCardBrush" Color="{StaticResource DwgCardColor}" />
    <SolidColorBrush x:Key="DwgBorderBrush" Color="{StaticResource DwgBorderColor}" />
    <SolidColorBrush x:Key="DwgSoftBorderBrush" Color="{StaticResource DwgSoftBorderColor}" />
    <SolidColorBrush x:Key="DwgTextBrush" Color="{StaticResource DwgTextColor}" />
    <SolidColorBrush x:Key="DwgMutedTextBrush" Color="{StaticResource DwgMutedTextColor}" />
    <SolidColorBrush x:Key="DwgSubtleTextBrush" Color="{StaticResource DwgSubtleTextColor}" />
    <SolidColorBrush x:Key="DwgAccentSoftBrush" Color="{StaticResource DwgAccentSoftColor}" />
    <SolidColorBrush x:Key="DwgButtonHoverBrush" Color="{StaticResource DwgButtonHoverColor}" />
    <SolidColorBrush x:Key="DwgDisabledBrush" Color="{StaticResource DwgDisabledColor}" />

    <Style x:Key="DwgRootDockStyle" TargetType="{x:Type DockPanel}">
        <Setter Property="Background" Value="{StaticResource DwgWindowBackgroundBrush}" />
        <Setter Property="LastChildFill" Value="True" />
    </Style>

    <Style x:Key="DwgTopBarStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource DwgAccentBrush}" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="DwgFooterBarStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource DwgWindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DwgSoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource DwgTextBrush}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="DwgHeaderTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="LineHeight" Value="27" />
    </Style>

    <Style x:Key="DwgHeaderSubtitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#F4ECFF" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="DwgSectionTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DwgTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style x:Key="DwgLabelTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource DwgMutedTextBrush}" />
        <Setter Property="Margin" Value="0,0,12,8" />
    </Style>

    <Style x:Key="DwgValueTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource DwgTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DwgMutedTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource DwgMutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DwgSmallMutedTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DwgMutedTextStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17" />
    </Style>

    <Style x:Key="DwgStatusTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DwgAccentBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="26" />
    </Style>

    <Style x:Key="DwgCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource DwgCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DwgBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="DwgSectionCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource DwgCardStyle}">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="DwgNoticeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource DwgAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="#DDCBFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource DwgBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource DwgTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DwgButtonHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DwgAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DwgAccentSoftBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DwgAccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DwgAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DwgDisabledBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DwgSoftBorderBrush}" />
                            <Setter TargetName="Chrome" Property="Background" Value="#F5F3F8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DwgPrimaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="Background" Value="{StaticResource DwgAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DwgAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DwgAccentHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DwgAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DwgAccentPressedBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DwgAccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DwgDisabledBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DwgDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DwgIconButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource DwgAccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DwgAccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#E5D2FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource DwgBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource DwgTextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DwgAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DwgDisabledBrush}" />
                            <Setter TargetName="Chrome" Property="Background" Value="#F5F3F8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DwgCompactTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="150" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource DwgBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DwgTextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource DwgTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <BulletDecorator>
                        <BulletDecorator.Bullet>
                            <Border x:Name="Box"
                                    Width="18"
                                    Height="18"
                                    Margin="0,1,0,0"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource DwgBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Path x:Name="CheckMark"
                                      Data="M 4 9 L 7.5 12.5 L 14 5"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="9,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DwgAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource DwgAccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DwgAccentBrush}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DwgDisabledBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DwgSoftBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Background" Value="{StaticResource DwgAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DwgAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="TemplateRoot" Height="{TemplateBinding Height}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" />
                        <Grid x:Name="PART_Track">
                            <Rectangle x:Name="PART_Indicator"
                                       HorizontalAlignment="Left"
                                       Fill="{TemplateBinding Foreground}"
                                       RadiusX="5"
                                       RadiusY="5" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DwgSoftBorderBrush}" />
        <Setter Property="RowBackground" Value="#FFFFFF" />
        <Setter Property="AlternatingRowBackground" Value="#FAF7FF" />
        <Setter Property="Foreground" Value="{StaticResource DwgTextBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource DwgSoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Foreground" Value="{StaticResource DwgMutedTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="MinHeight" Value="32" />
    </Style>
</ResourceDictionary>
