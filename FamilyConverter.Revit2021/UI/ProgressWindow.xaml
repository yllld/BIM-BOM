<Window x:Class="FamilyConverter.Revit2021.UI.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG Converter - процесс"
        Width="460"
        Height="260"
        ResizeMode="NoResize"
        Background="#F7F4FF"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#8C30FF" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#DED0F8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#665E73" />
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="14">
        <StackPanel>
            <TextBlock x:Name="CurrentStatusText"
                       Text="Подготовка"
                       Foreground="#25153D"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14" />

            <TextBlock x:Name="Phase0Text" Text="Предварительный анализ" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
            <ProgressBar x:Name="Phase0Bar" Height="8" Minimum="0" Maximum="100" Margin="0,0,0,10" Foreground="{StaticResource AccentBrush}" />

            <TextBlock x:Name="Phase1Text" Text="Извлечение геометрии" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
            <ProgressBar x:Name="Phase1Bar" Height="8" Minimum="0" Maximum="100" Margin="0,0,0,10" Foreground="{StaticResource AccentBrush}" />

            <TextBlock x:Name="Phase2Text" Text="Создание геометрии и отчетов" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
            <ProgressBar x:Name="Phase2Bar" Height="8" Minimum="0" Maximum="100" Margin="0,0,0,10" Foreground="{StaticResource AccentBrush}" />

            <TextBlock x:Name="Phase3Text" Text="Открытие отчета" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
            <ProgressBar x:Name="Phase3Bar" Height="8" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}" />
        </StackPanel>
    </Border>
</Window>
