<Window x:Class="FamilyConverter.Revit2021.UI.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG Converter - процесс"
        Width="560"
        Height="300"
        MinWidth="520"
        MinHeight="280"
        ResizeMode="NoResize"
        Background="#F7F6FA"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DwgConverterTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Style="{StaticResource DwgRootDockStyle}">
        <Border DockPanel.Dock="Top" Style="{StaticResource DwgTopBarStyle}" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="28"
                        Height="28"
                        CornerRadius="7"
                        Background="#FFFFFF"
                        Margin="0,0,10,0">
                    <TextBlock Text="R"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource DwgAccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="DWG Converter" Style="{StaticResource DwgHeaderTitleTextStyle}" FontSize="16" LineHeight="20" />
                    <TextBlock Text="Преобразование геометрии" Style="{StaticResource DwgHeaderSubtitleTextStyle}" Margin="0,1,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="16">
            <Border Style="{StaticResource DwgCardStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentStatusText"
                               Text="Готовим конвертацию..."
                               Style="{StaticResource DwgStatusTitleTextStyle}"
                               Margin="0,0,0,8" />

                    <TextBlock x:Name="SecondaryStatusText"
                               Text="Собираем входные данные и держим допуски под рукой."
                               Style="{StaticResource DwgMutedTextStyle}"
                               TextAlignment="Center"
                               Margin="0,0,0,22" />

                    <Grid Margin="2,0,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StageText" Text="Этап 0 из 4" Style="{StaticResource DwgSmallMutedTextStyle}" />
                        <TextBlock Grid.Column="1" x:Name="ProgressPercentText" Text="0%" Foreground="{StaticResource DwgAccentBrush}" FontWeight="SemiBold" />
                    </Grid>

                    <ProgressBar x:Name="OverallProgressBar" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
