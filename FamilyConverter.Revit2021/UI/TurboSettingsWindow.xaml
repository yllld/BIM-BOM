<Window x:Class="FamilyConverter.Revit2021.UI.TurboSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG Converter - Family Geometry Turbo"
        Width="640"
        Height="650"
        MinWidth="590"
        MinHeight="560"
        Background="#F7F6FA"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DwgConverterTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Style="{StaticResource DwgRootDockStyle}">
        <Border DockPanel.Dock="Top" Style="{StaticResource DwgTopBarStyle}">
            <StackPanel>
                <TextBlock Text="Turbo FreeForm" Style="{StaticResource DwgHeaderTitleTextStyle}" />
                <TextBlock Text="Быстрая конвертация тяжелой DWG с отсечением мелкой геометрии" Style="{StaticResource DwgHeaderSubtitleTextStyle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource DwgFooterBarStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Запустить Turbo"
                        Width="148"
                        Style="{StaticResource DwgPrimaryButtonStyle}"
                        IsDefault="True"
                        Margin="0,0,10,0"
                        Click="RunButton_Click" />
                <Button Content="Отмена"
                        Width="112"
                        IsCancel="True" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <Border Style="{StaticResource DwgSectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Фильтр мелких деталей" Style="{StaticResource DwgSectionTitleTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Минимальный объем Solid, мм³" Style="{StaticResource DwgLabelTextStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="MinVolumeTextBox" Style="{StaticResource DwgCompactTextBoxStyle}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Минимальный максимальный габарит, мм" Style="{StaticResource DwgLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="MinMaxDimensionTextBox" Style="{StaticResource DwgCompactTextBoxStyle}" />
                        </Grid>

                        <Border Style="{StaticResource DwgNoticeStyle}" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource DwgSmallMutedTextStyle}"
                                       Text="Solid будет пропущен, если его объем меньше порога или самый большой габарит меньше указанного значения. Значение 0 отключает соответствующий порог." />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DwgSectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Turbo-допуски" Style="{StaticResource DwgSectionTitleTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Допуск габаритов, мм" Style="{StaticResource DwgLabelTextStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="BBoxToleranceTextBox" Style="{StaticResource DwgCompactTextBoxStyle}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Допуск объема, %" Style="{StaticResource DwgLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="VolumeToleranceTextBox" Style="{StaticResource DwgCompactTextBoxStyle}" />
                        </Grid>

                        <CheckBox x:Name="ValidateGeometryCheckBox" Margin="0,14,0,0">
                            <TextBlock Text="Проверять созданную геометрию по этим допускам (медленнее)"
                                       TextWrapping="Wrap" />
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DwgSectionCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Отчеты" Style="{StaticResource DwgSectionTitleTextStyle}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="JsonReportCheckBox" Content="Создать отчет JSON" Margin="0,0,24,0" />
                            <CheckBox Grid.Column="1" x:Name="CsvReportCheckBox" Content="Создать отчет CSV" Margin="0" />
                        </Grid>
                        <TextBlock Style="{StaticResource DwgSmallMutedTextStyle}"
                                   Text="В Turbo-режиме Extrusion, AI, слои DWG и Curve/Mesh отключены для скорости. Проверку созданной геометрии лучше включать только для контрольных запусков." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
