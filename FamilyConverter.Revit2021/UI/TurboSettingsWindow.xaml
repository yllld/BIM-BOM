<Window x:Class="FamilyConverter.Revit2021.UI.TurboSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG Converter - Family Geometry Turbo"
        Width="560"
        Height="520"
        MinWidth="520"
        MinHeight="460"
        Background="#F4F7F6"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#1E7260" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#D6E2DF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#60706B" />

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#B9CCC7" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Foreground" Value="#243832" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#155446" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="18,14">
            <StackPanel>
                <TextBlock Text="Turbo FreeForm" Foreground="#FFFFFF" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="Грубая конвертация тяжелой DWG с отсечением мелкой геометрии" Foreground="#D7ECE7" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14">
            <Button Content="Запустить Turbo" Width="130" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="RunButton_Click" />
            <Button Content="Отмена" Width="100" IsCancel="True" />
        </StackPanel>

        <StackPanel Margin="14">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Фильтр мелких деталей" FontSize="15" FontWeight="SemiBold" Foreground="#20322D" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Минимальный объем Solid, мм³" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,8" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="MinVolumeTextBox" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Минимальный максимальный габарит, мм" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MinMaxDimensionTextBox" />
                    </Grid>
                    <TextBlock Text="Solid будет пропущен, если его объем меньше порога или его самый большой габарит меньше указанного значения. Значение 0 отключает соответствующий порог."
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Turbo-допуски" FontSize="15" FontWeight="SemiBold" Foreground="#20322D" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Допуск габаритов, мм" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,8" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="BBoxToleranceTextBox" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Допуск объема, %" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="VolumeToleranceTextBox" />
                    </Grid>
                    <CheckBox x:Name="ValidateGeometryCheckBox"
                              Content="Проверять созданную геометрию по этим допускам (медленнее)"
                              Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="Отчеты" FontSize="15" FontWeight="SemiBold" Foreground="#20322D" Margin="0,0,0,10" />
                    <CheckBox x:Name="JsonReportCheckBox" Content="Создать отчет JSON" />
                    <CheckBox x:Name="CsvReportCheckBox" Content="Создать отчет CSV" />
                    <TextBlock Text="В Turbo-режиме Extrusion, AI, слои DWG и Curve/Mesh отключены для скорости. Проверку созданной геометрии лучше включать только для контрольных запусков."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
