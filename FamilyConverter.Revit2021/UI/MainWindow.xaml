<Window x:Class="FamilyConverter.Revit2021.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG Converter - Family Geometry"
        Width="600"
        Height="590"
        MinWidth="560"
        MinHeight="540"
        Background="#F7F6FA"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DwgConverterTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Style="{StaticResource DwgRootDockStyle}">
        <Border DockPanel.Dock="Top" Style="{StaticResource DwgTopBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DWG Converter - Family Geometry" Style="{StaticResource DwgHeaderTitleTextStyle}" />
                    <TextBlock Text="Simple Convert" Style="{StaticResource DwgHeaderSubtitleTextStyle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="SettingsButton"
                        Style="{StaticResource DwgIconButtonStyle}"
                        ToolTip="Настройки конвертации"
                        Margin="12,0,0,0"
                        Click="SettingsButton_Click" />
                <Button Grid.Column="2"
                        x:Name="AiButton"
                        Style="{StaticResource DwgIconButtonStyle}"
                        ToolTip="AI-настройки"
                        Margin="8,0,0,0"
                        Click="AiButton_Click" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource DwgFooterBarStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Преобразовать"
                        Width="148"
                        Style="{StaticResource DwgPrimaryButtonStyle}"
                        IsDefault="True"
                        Margin="0,0,10,0"
                        Click="ConvertButton_Click" />
                <Button Content="Отмена"
                        Width="112"
                        IsCancel="True" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <Border Style="{StaticResource DwgSectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Источник" Style="{StaticResource DwgSectionTitleTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ElementId" Style="{StaticResource DwgLabelTextStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ElementIdText" Style="{StaticResource DwgValueTextStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Category" Style="{StaticResource DwgLabelTextStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CategoryText" Style="{StaticResource DwgValueTextStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Solid" Style="{StaticResource DwgLabelTextStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SolidCountText" Style="{StaticResource DwgValueTextStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Mesh" Style="{StaticResource DwgLabelTextStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MeshCountText" Style="{StaticResource DwgValueTextStyle}" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Curve" Style="{StaticResource DwgLabelTextStyle}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CurveCountText" Style="{StaticResource DwgValueTextStyle}" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Слои" Style="{StaticResource DwgLabelTextStyle}" Margin="0,0,12,0" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="LayersText" Style="{StaticResource DwgValueTextStyle}" Margin="0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DwgSectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Текущий профиль" Style="{StaticResource DwgSectionTitleTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Ellipse Grid.Row="0" Width="7" Height="7" Fill="{StaticResource DwgAccentBrush}" VerticalAlignment="Top" Margin="1,6,0,0" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ModeSummaryText" Style="{StaticResource DwgValueTextStyle}" />
                            <Ellipse Grid.Row="1" Width="7" Height="7" Fill="{StaticResource DwgAccentBrush}" VerticalAlignment="Top" Margin="1,6,0,0" Opacity="0.75" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ToleranceSummaryText" Style="{StaticResource DwgMutedTextStyle}" Margin="0,0,0,8" />
                            <Ellipse Grid.Row="2" Width="7" Height="7" Fill="{StaticResource DwgAccentBrush}" VerticalAlignment="Top" Margin="1,6,0,0" Opacity="0.55" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AiSummaryText" Style="{StaticResource DwgMutedTextStyle}" Margin="0,0,0,8" />
                            <Ellipse Grid.Row="3" Width="7" Height="7" Fill="{StaticResource DwgAccentBrush}" VerticalAlignment="Top" Margin="1,6,0,0" Opacity="0.45" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ReportSummaryText" Style="{StaticResource DwgMutedTextStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
