<Window x:Class="FamilyConverter.Revit2021.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG Converter - Family Geometry"
        Width="620"
        Height="560"
        MinWidth="560"
        MinHeight="500"
        Background="#F7F4FF"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#8C30FF" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#5D16B7" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#DED0F8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#665E73" />

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#25153D" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E7DAFF" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DWG Converter - Family Geometry" Foreground="#FFFFFF" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Simple Convert" Foreground="#F0E6FF" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="SettingsButton"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Настройки конвертации"
                        Click="SettingsButton_Click" />
                <Button Grid.Column="2"
                        x:Name="AiButton"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="AI-настройки"
                        Click="AiButton_Click" />
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,4,14,14">
            <Button Content="Преобразовать" Width="140" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="ConvertButton_Click" />
            <Button Content="Отмена" Width="100" IsCancel="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14">
            <StackPanel>
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Источник" Style="{StaticResource SectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ElementId" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ElementIdText" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Category" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,6" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CategoryText" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Solid" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,6" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SolidCountText" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Mesh" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,6" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MeshCountText" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Curve" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,6" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CurveCountText" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Слои" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="LayersText" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Текущий профиль" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="ModeSummaryText" Foreground="#25153D" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock x:Name="ToleranceSummaryText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock x:Name="AiSummaryText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock x:Name="ReportSummaryText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
