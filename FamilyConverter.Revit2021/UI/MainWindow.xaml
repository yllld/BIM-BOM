<Window x:Class="FamilyConverter.Revit2021.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG Converter - Family Geometry"
        Width="760"
        Height="780"
        MinWidth="680"
        MinHeight="640"
        Background="#F4F7F6"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#1E7260" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#155446" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#D6E2DF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#60706B" />

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#20322D" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2,0,7" />
            <Setter Property="Foreground" Value="#243832" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#B9CCC7" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DWG Converter - Family Geometry" Foreground="#FFFFFF" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Simple Convert" Foreground="#D7ECE7" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="#D7ECE7" BorderThickness="1" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="Revit 2021" Foreground="#FFFFFF" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,4,14,14">
            <Button Content="Преобразовать" Width="140" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="ConvertButton_Click" />
            <Button Content="Отмена" Width="100" IsCancel="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14">
            <StackPanel>
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Источник" Style="{StaticResource SectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ElementId" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ElementIdText" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Category" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,6" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CategoryText" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Solid найдено" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,6" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SolidCountText" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Mesh найдено" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,6" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MeshCountText" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Curve найдено" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,6" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CurveCountText" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Основные слои" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="LayersText" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Режим преобразования" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox x:Name="CreateExtrusionsCheckBox" Content="Создавать нативные Extrusion для распознанных тел" />
                        <CheckBox x:Name="TryExtrusionBeforeFreeFormCheckBox" Content="Пробовать Extrusion для сомнительных профилей с откатом в FreeFormElement" />
                        <CheckBox x:Name="UseFreeFormCheckBox" Content="Для сложных Solid использовать FreeFormElement" />
                        <CheckBox x:Name="DeleteSourceCheckBox" Content="Удалить исходный DWG после успешного преобразования" />
                        <CheckBox x:Name="CreateSubcategoriesCheckBox" Content="Создавать подкатегории по слоям DWG, если слой определен" />
                        <CheckBox x:Name="JsonReportCheckBox" Content="Создать отчет JSON" />
                        <CheckBox x:Name="CsvReportCheckBox" Content="Создать отчет CSV" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="126" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="AI" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                  x:Name="UseAiCheckBox"
                                  Content="Использовать AI-советник для сомнительных случаев" />
                        <TextBox Grid.Row="2" Grid.Column="0" x:Name="AiConfigPathTextBox" Margin="0,0,8,0" />
                        <Button Grid.Row="2" Grid.Column="1" Content="Выбрать JSON" Margin="0,0,8,0" Click="BrowseAiConfigButton_Click" />
                        <Button Grid.Row="2" Grid.Column="2" Content="Проверить конфиг" Click="ValidateAiConfigButton_Click" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                   x:Name="AiConfigStatusText"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Text="API-ключи не хранятся в плагине. Используется только локальный JSON пользователя." />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Допуски" Style="{StaticResource SectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="310" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Минимальный объем Solid, мм³" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,8" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="MinVolumeTextBox" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Допуск совпадения габаритов, мм" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,8" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="BBoxToleranceTextBox" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Допуск сравнения объема, %" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,8" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="VolumeToleranceTextBox" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Допуск замыкания контура, мм" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,8" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="LoopToleranceTextBox" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Минимальная уверенность для Extrusion" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="ConfidenceTextBox" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
