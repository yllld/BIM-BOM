<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DWGConverter-FamilyGeometry-Revit2025-Installer</AssemblyName>
    <RootNamespace>DWGConverter.FamilyGeometry.Revit2025.Installer</RootNamespace>
    <StartupObject>DWGConverter.FamilyGeometry.Revit2025.Installer.Program</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <ProjectReference Include="..\FamilyConverter.Revit2025\FamilyConverter.Revit2025.csproj"
                      ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="..\FamilyConverter.Revit2025\bin\$(Configuration)\FamilyConverter.Revit2025.dll">
      <Link>Payload\FamilyConverter.Revit2025.dll</Link>
    </EmbeddedResource>
  </ItemGroup>
</Project>
